{
  "name": "dsh-md3-theme",
  "version": "0.7.0",
  "description": "Material Design 3 theme for DeepSeek Harness: HCT-generated light/dark palettes with seven accent presets, applied through the theme token layer.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "theme",
    "material-design-3",
    "material-you",
    "md3"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "esbuild scripts/generate-palettes.mjs --bundle --platform=node --format=esm --outfile=.cache/generate-palettes.mjs --log-level=warning && node .cache/generate-palettes.mjs",
    "build": "node build.mjs",
    "check": "npm run generate && npm run build && node --check lib/client.js && node --check lib/index.js && node scripts/smoke.mjs",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-store": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-ui-theme": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-theme": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyomufs/dsh-md3-theme.git"
  }
}
